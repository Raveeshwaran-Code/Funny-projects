# 4. ENTRY DIFFICULTY SELECTION WINDOW
# ==============================================================================
class DifficultyMenu:
    def __init__(self, menu_root):
        self.menu_root = menu_root
        self.menu_root.title("Select Game Level")
        self.menu_root.geometry("350x250")
        self.menu_root.resizable(False, False)
        
        # Add visual window text titles
        label = tk.Label(menu_root, text="Choose AI Difficulty", font=("Arial", 16, "bold"), pady=15)
        label.pack()
        
        # Create standard selection option buttons
        btn_easy = tk.Button(menu_root, text="1 - Easy Mode (Basics)", font=("Arial", 11), bg="#2ecc71", fg="white", 
                             width=25, height=2, command=lambda: self.launch_game(1, False, "Easy"))
        btn_easy.pack(pady=5)
        
        btn_medium = tk.Button(menu_root, text="2 - Medium Mode (Intermediate)", font=("Arial", 11), bg="#f1c40f", fg="black", 
                               width=25, height=2, command=lambda: self.launch_game(2, True, "Medium"))
        btn_medium.pack(pady=5)
        
        btn_hard = tk.Button(menu_root, text="3 - Hard Mode (Advanced)", font=("Arial", 11), bg="#e74c3c", fg="white", 
                             width=25, height=2, command=lambda: self.launch_game(3, True, "Advanced"))
        btn_hard.pack(pady=5)

    def launch_game(self, depth, use_ordering, level_name):
        """Destroys the setup selection window and turns on the actual chess game layout board."""
        self.menu_root.destroy() # Close the option popup window frame cleanly
        
        game_window = tk.Tk()
        gui = ChessGUI(game_window, depth, use_ordering, level_name)
        game_window.mainloop()

if __name__ == "__main__":
    menu_window = tk.Tk()
    menu = DifficultyMenu(menu_window)
    menu_window.mainloop()
