import tkinter as tk
from tkinter import messagebox
import chess
import random

# ==============================================================================
# 1. GAME SETTINGS & VALUES
# ==============================================================================
PIECE_VALUES = {
    chess.PAWN: 100, 
    chess.KNIGHT: 320, 
    chess.BISHOP: 330,
    chess.ROOK: 500, 
    chess.QUEEN: 900, 
    chess.KING: 20000
}

PIECE_UNICODE = {
    'R': '♖', 'N': '♘', 'B': '♗', 'Q': '♕', 'K': '♔', 'P': '♙', 
    'r': '♜', 'n': '♞', 'b': '♝', 'q': '♛', 'k': '♚', 'p': '♟'  
}

# ==============================================================================
# 2. AI BRAIN & CALCULATIONS
# ==============================================================================
def evaluate_board(board):
    if board.is_checkmate():
        return -99999 if board.turn == chess.WHITE else 99999
    if board.is_game_over():
        return 0
        
    score = 0
    for square in chess.SQUARES:
        piece = board.piece_at(square)
        if piece:
            value = PIECE_VALUES[piece.piece_type]
            if piece.color == chess.WHITE:
                score += value
            else:
                score -= value
    return score

def order_moves(board, legal_moves):
    def move_score(move):
        score = 0
        if board.is_capture(move):
            victim = board.piece_at(move.to_square)
            attacker = board.piece_at(move.from_square)
            if victim and attacker:
                score += 10 * PIECE_VALUES[victim.piece_type] - PIECE_VALUES[attacker.piece_type]
        if board.gives_check(move):
            score += 50
        return score
    return sorted(legal_moves, key=move_score, reverse=True)

def minimax_advanced(board, depth, alpha, beta, maximizing_player, use_ordering=True):
    if depth == 0 or board.is_game_over():
        return evaluate_board(board), None

    # Only sort moves if ordering option is active (disabled for easy level)
    if use_ordering:
        legal_moves = order_moves(board, list(board.legal_moves))
    else:
        legal_moves = list(board.legal_moves)
        random.shuffle(legal_moves)
        
    best_move = None

    if maximizing_player:
        max_eval = -float('inf')
        for move in legal_moves:
            board.push(move)
            eval_score, _ = minimax_advanced(board, depth - 1, alpha, beta, False, use_ordering)
            board.pop()
            if eval_score > max_eval:
                max_eval = eval_score
                best_move = move
            alpha = max(alpha, eval_score)
            if beta <= alpha: break 
        return max_eval, best_move
    else:
        min_eval = float('inf')
        for move in legal_moves:
            board.push(move)
            eval_score, _ = minimax_advanced(board, depth - 1, alpha, beta, True, use_ordering)
            board.pop()
            if eval_score < min_eval:
                min_eval = eval_score
                best_move = move
            beta = min(beta, eval_score)
            if beta <= alpha: break 
        return min_eval, best_move

# ==============================================================================
# 3. VISUAL GRAPHICS INTERFACE (GUI)
# ==============================================================================
class ChessGUI:
    def __init__(self, root, depth, use_ordering, level_name):
        self.root = root
        self.root.title(f"Python Chess - Level: {level_name}")
        self.root.resizable(False, False)
        
        # AI Config passed down from menu selection
        self.ai_depth = depth
        self.use_ordering = use_ordering
        
        self.board = chess.Board()
        self.selected_square = None
        self.square_size = 75 
        
        self.color_light = "#f0d9b5"       
        self.color_dark = "#b58863"        
        self.color_highlight = "#829769"   
        self.color_legal = "#6495ed"       
        
        self.canvas = tk.Canvas(root, width=self.square_size*8, height=self.square_size*8)
        self.canvas.pack()
        self.canvas.bind("<Button-1>", self.on_click) 
        
        self.draw_board()

    def draw_board(self):
        self.canvas.delete("all")
        legal_destinations = []
        
        if self.selected_square is not None:
            for move in self.board.legal_moves:
                if move.from_square == self.selected_square:
                    legal_destinations.append(move.to_square)
                    
        for rank in range(8):
            for file in range(8):
                sq = chess.square(file, 7 - rank)
                x1, y1 = file * self.square_size, rank * self.square_size
                x2, y2 = x1 + self.square_size, y1 + self.square_size
                
                bg = self.color_light if (rank + file) % 2 == 0 else self.color_dark
                if sq == self.selected_square:
                    bg = self.color_highlight
                elif sq in legal_destinations:
                    bg = self.color_legal
                    
                self.canvas.create_rectangle(x1, y1, x2, y2, fill=bg, outline="")
                
                piece = self.board.piece_at(sq)
                if piece:
                    symbol = PIECE_UNICODE[piece.symbol()]
                    p_color = "#FFFFFF" if piece.color == chess.WHITE else "#1A1A1A"
                    self.canvas.create_text(x1 + self.square_size//2, y1 + self.square_size//2, 
                                             text=symbol, font=("Arial", 38), fill=p_color)

    def on_click(self, event):
        if self.board.turn == chess.BLACK:
            return  
            
        file = event.x // self.square_size
        rank = 7 - (event.y // self.square_size)
        clicked_sq = chess.square(file, rank)
        
        if self.selected_square is None:
            piece = self.board.piece_at(clicked_sq)
            if piece and piece.color == chess.WHITE:
                self.selected_square = clicked_sq
        else:
            move = chess.Move(self.selected_square, clicked_sq)
            
            if self.board.piece_at(self.selected_square) and self.board.piece_at(self.selected_square).piece_type == chess.PAWN:
                if chess.square_rank(clicked_sq) == 7:
                    move.promotion = chess.QUEEN
                    
            if move in self.board.legal_moves:
                self.board.push(move)
                self.selected_square = None
                self.draw_board()
                self.root.update() 
                
                if not self.check_game_over():
                    self.root.after(100, self.trigger_ai) 
            else:
                self.selected_square = None 
        self.draw_board()

    def trigger_ai(self):
        original_title = self.root.title()
        self.root.title("AI is thinking...")
        
        # Calculates options based on user menu selections
        _, ai_move = minimax_advanced(self.board, self.ai_depth, -float('inf'), float('inf'), 
                                      maximizing_player=False, use_ordering=self.use_ordering)
        if ai_move:
            self.board.push(ai_move)
            
        self.root.title(original_title)
        self.draw_board()
        self.check_game_over()

    def check_game_over(self):
        if self.board.is_game_over():
            if self.board.is_checkmate():
                winner = "Black (AI)" if self.board.turn == chess.WHITE else "White (You)"
                messagebox.showinfo("Game Over", f" Checkmate! {winner} wins!")
            else:
                messagebox.showinfo("Game Over", " Draw game!")
            return True
        return False

